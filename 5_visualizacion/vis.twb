        <calculation class='tableau' formula='IF [Calculation_3425803935404039] &gt;= 0 AND [Calculation_3425803935404039] &lt; 25 THEN &quot;0-25&quot;&#13;&#10;ELSEIF [Calculation_3425803935404039] &gt;= 25 AND [Calculation_3425803935404039] &lt; 50 THEN &quot;25-50&quot;&#13;&#10;ELSEIF [Calculation_3425803935404039] &gt;= 50 AND [Calculation_3425803935404039] &lt; 75 THEN &quot;50-75&quot;&#13;&#10;ELSEIF [Calculation_3425803935404039] &gt;= 75 AND [Calculation_3425803935404039] &lt;= 100 THEN &quot;75-100&quot;&#13;&#10;END' />
      </column>
