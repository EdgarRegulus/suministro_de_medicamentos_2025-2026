      <column caption='ahorro_potencial' datatype='real' name='[Calculation_3425803946041354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([precio]-[Calculation_3425803935105030])*[cantidad]' />
      </column>
      <column caption='oportunidad_compra' datatype='string' name='[Calculation_3425803946254347]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3425803935404039] &gt;= 0.8 THEN &quot;Sobreprecio extremo&quot;&#13;&#10;ELSEIF [Calculation_3425803935404039] &gt;= 0.6 THEN &quot;Sobreprecio alto&quot;&#13;&#10;ELSEIF [Calculation_3425803935404039] &gt;= 0.4 THEN &quot;Sobreprecio moderado&quot;&#13;&#10;ELSEIF [Calculation_3425803935404039] &gt;= 0.2 THEN &quot;Sobreprecio ligero&quot;&#13;&#10;ELSE &quot;Precio adecuado&quot;&#13;&#10;END' />
      </column>
      <column caption='potencial_ahorro' datatype='real' name='[Calculation_3733942475157504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([precio]-[Calculation_3425803935105030])*[cantidad]' />
