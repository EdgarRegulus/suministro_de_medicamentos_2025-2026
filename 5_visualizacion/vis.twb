      </column>
      <column caption='Precio minimo' datatype='real' name='[Calculation_3425803935105030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [clave (adjudicaciones.csv)]: MIN([precio]) }' />
      </column>
      <column caption='margen_porcentual' datatype='real' name='[Calculation_3425803935404039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([precio]-[Calculation_3425803935105030])/[precio]' />
